# Run with: ris run manual/load.ri
module manual/load

import std/text
import db/db
import db/testing/dummy_driver::*

CONNECTION = "dummy://host"

struct Completed
  getter index : Int32

  def initialize(@index : Int32)
  end
end

struct Finished
end

COUNT = 200

def start_consumer
  indeces = Set(Int32).new
  while true
    received = RisBoard.take(Completed)
    raise "consumer cancelled" if received.is_a?(Cancelled)
    indeces.add received.index
    puts "Received size=#{indeces.size}"
    break if indeces.size == COUNT
  end
  RisBoard.post(Finished.new)
end

def start_producers
  group do |g|
    COUNT.times do |index|
      g.spawn do
        ::Db::Db.open(CONNECTION) do |db|
          sql = "1,title,description,2023 " * 100_000
          rows = 0
          db.query_each(sql) do |rs|
            assert rs.read(Int32).or_panic == 1
            assert rs.read(String).or_panic == "title"
            assert rs.read(String).or_panic == "description"
            assert rs.read(Int32).or_panic == 2023
            rows += 1
          end.or_panic
          assert rows == 100_000
        end.or_panic
        RisBoard.post(Completed.new(index))
        0
      end
    end
  end
end

group do |g|
  # crystal's `start_consumer` spawned the consumer itself; a ris task
  # belongs to a group, so it is spawned here.
  g.spawn do
    start_consumer
    0
  end
  start_producers

  RisBoard.take(Finished)
end
