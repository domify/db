# One connection per block and task.
module db/db

import std/uri::{ParsedURI, URI, Params}
import db/errors::*
import db/core::*

pub VERSION = "0.2.0"

DRIVERS = {} of String => Driver.class

# The driver class registered for *driver_name*.
pub def driver_class(driver_name : String) : Driver.class | DBError
  DRIVERS[driver_name]? ||
    ArgumentError.new(%(no driver was registered for the schema "#{driver_name}", did you maybe forget to require the database driver?))
end

# Registers a driver class for a given *driver_name*. Called by driver
# implementors, from their module's top level, so importing the driver is
# what registers it.
#
# Generic so the driver's own class never becomes the argument type of this
# module's compiled code: a call with `PgDriver` would compile a
# `register_driver(String, PgDriver.class)` that this module's artifact
# cannot carry (ris 0.1.0).
pub def register_driver(driver_name : String, driver_class : D.class) : Nil forall D
  store_driver(driver_name, driver_class.as(Driver.class))
end

def store_driver(driver_name : String, driver_class : Driver.class) : Nil
  DRIVERS[driver_name] = driver_class
end

# Opens a connection to *uri* for the block and closes it when the block is
# left. The scheme of the *uri* determines the driver to use; the connection
# belongs to the task that opened it (SPEC 5.1).
pub def open(uri : String, & : Connection -> U) : U | DBError forall U
  parsed = parse_uri(uri)!
  open(parsed) { |connection| yield connection }
end

# :ditto:
pub def open(uri : URI | ParsedURI, & : Connection -> U) : U | DBError forall U
  klass = driver_class(uri.scheme || "")!
  driver = klass.new
  options = driver.connection_options(Params.parse(uri.query || ""))!
  connection = driver.new_connection(uri, options)
  connection.open!
  defer connection.close
  yield connection
end

# The same as `open`, under crystal-db's name for one connection.
pub def connect(uri : String, & : Connection -> U) : U | DBError forall U
  open(uri) { |connection| yield connection }
end

# :ditto:
pub def connect(uri : URI | ParsedURI, & : Connection -> U) : U | DBError forall U
  open(uri) { |connection| yield connection }
end

def parse_uri(uri : String) : ParsedURI | DBError
  URI.parse?(uri) || ArgumentError.new(%(invalid connection URI "#{uri}"))
end
