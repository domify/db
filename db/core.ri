# Drivers, connections, statements, result sets and transactions: the types a
# driver subclasses and a program queries through.
#
# They refer to one another (a statement belongs to a connection, a result set
# to a statement), and an import graph has no cycles (R-1), so they live in one
# module, as they live in one namespace in crystal-db.
#
# What changed from crystal-db, all of it for ris's memory rules (SPEC 1.1, 1.9,
# 2.1, 5.1):
#
# * Every call that can fail answers `T | DBError` instead of raising.
#   `DBError` is a flat struct, so `!` carries it out of any def or block.
# * A connection belongs to the block that opened it, and to its task. There is
#   no pool: `Db::Db.open(uri) { |db| ... }` gives one connection, and a task
#   that wants its own connection opens its own.
# * An object is built first and does its work after, because a def can answer
#   a new object only as its one call: `build_statement` then `prepare`,
#   `new_connection` then `open`. Constructors do no IO.
# * Statements, result sets and transactions live in a block as well:
#   `query { |rs| }`, `with_statement { |stmt| }`, `transaction { |tx| }`. Text
#   read from a column is valid inside the block that read it.
# * A `transaction` block that is left early - `return`, `break`, `!`
#   propagating an error, a panic - rolls back. Crystal committed on `return`
#   and rolled back on `raise`; ris's `!` is a `return`, so the two cannot be
#   told apart, and rolling back is the side that cannot lose data. Call
#   `tx.commit` before a `return` that should commit.
# * There are no hooks around a statement (crystal-db's
#   `def_around_query_or_exec`): a proc kept in a registry cannot be proved not
#   to retain the statement or its arguments. `LOG` at debug level writes each
#   query with its arguments.
module db/core

import std/uri::{ParsedURI, URI, Params}
import std/log::{Log, Logger}
import std/random::{Random}
import std/text
import db/errors::*
import db/value::*
import db/query_params::*

# The logger every statement writes "Executing query" to, at debug level.
# crystal-db's `DB::Log`; its source is "db".
pub LOG = Log.for("db")

# A resource with a `close` that runs once: connections, statements, result
# sets and transactions. An implementer declares `@closed = false` and a
# `do_close`.
pub trait Disposable
  # Closes this object. A `do_close` that answers an error leaves it open.
  def close : Nil | DBError
    return nil if @closed
    do_close!
    @closed = true
    nil
  end

  # Returns `true` if this object is closed. See `#close`.
  def closed? : Bool
    # compared, not answered: read through an artifact, an implementer's
    # `@closed` can come back typed `Bool | Nil` (ris 0.1.0)
    @closed == true
  end
end

# The queries of a session, which builds its statements with `new_statement`.
#
# A value that is text or bytes lives on the tape and is read inside a block:
# `scalar(q) { |value| }`, `query(q) { |rs| }`. The `as:` forms answer flat
# values (numbers, Bool, Time, tuples of them) and refuse a type that holds
# text when compiled.
pub trait QueryMethods
  # Yields *query* prepared; it is closed when the block is left.
  def with_statement(query : String, & : Statement -> U) : U | DBError forall U
    stmt = new_statement(query)
    defer stmt.close
    stmt.prepare!
    yield stmt
  end

  # Runs *query* and yields its result set, closed when the block is left.
  def query(query : String, *args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : U | DBError forall T, A, U
    with_statement(query) do |stmt|
      stmt.query(*args_, args: args) { |rs| yield rs }
    end
  end

  # Runs *query* and yields its single row; `NoResultsError` without one, an
  # error with more than one.
  def query_one(query : String, *args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : U | DBError forall T, A, U
    query(query, *args_, args: args) do |rs|
      return NoResultsError.new("no results") unless rs.move_next!
      value = yield rs
      return DBFailure.new("more than one row") if rs.move_next!
      value
    end
  end

  # Runs *query* and reads its single row as *klass*.
  def query_one(query : String, *args_ : *T, args : Array(A)? = nil, as klass : K.class) : K | DBError forall T, A, K
    query_one(query, *args_, args: args) { |rs| rs.read(klass)! }
  end

  # `query_one`, with `nil` for no row.
  def query_one?(query : String, *args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : U | Nil | DBError forall T, A, U
    query(query, *args_, args: args) do |rs|
      return nil unless rs.move_next!
      value = yield rs
      return DBFailure.new("more than one row") if rs.move_next!
      value
    end
  end

  # `query_one`, with `nil` for no row.
  def query_one?(query : String, *args_ : *T, args : Array(A)? = nil, as klass : K.class) : K | Nil | DBError forall T, A, K
    query_one?(query, *args_, args: args) { |rs| rs.read(klass)! }
  end

  # What the block answers for each row.
  def query_all(query : String, *args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : Array(U) | DBError forall T, A, U
    ary = [] of U
    query_each(query, *args_, args: args) do |rs|
      ary << yield rs
    end!
    ary
  end

  # Each row read as *klass*.
  def query_all(query : String, *args_ : *T, args : Array(A)? = nil, as klass : K.class) : Array(K) | DBError forall T, A, K
    query_all(query, *args_, args: args) { |rs| rs.read(klass)! }
  end

  # Yields the result set at each row.
  def query_each(query : String, *args_ : *T, args : Array(A)? = nil, & : ResultSet -> Nil) : Nil | DBError forall T, A
    query(query, *args_, args: args) do |rs|
      while rs.move_next!
        yield rs
      end
      nil
    end
  end

  # Runs *query*, answering how many rows it changed and the last id.
  def exec(query : String, *args_ : *T, args : Array(A)? = nil) : ExecResult | DBError forall T, A
    with_statement(query) do |stmt|
      stmt.exec(*args_, args: args)
    end
  end

  # Yields the first column of the first row.
  def scalar(query : String, *args_ : *T, args : Array(A)? = nil, & : DBValue -> U) : U | DBError forall T, A, U
    query(query, *args_, args: args) do |rs|
      return NoResultsError.new("no results") unless rs.move_next!
      value = rs.read!
      yield value
    end
  end

  # The first column of the first row, as the flat type *klass*.
  def scalar(query : String, *args_ : *T, args : Array(A)? = nil, as klass : K.class) : K | DBError forall T, A, K
    query(query, *args_, args: args) do |rs|
      return NoResultsError.new("no results") unless rs.move_next!
      rs.read(klass)!
    end
  end
end

# What a session queries through: its statements as its options say, or always
# `prepared` or `unprepared`.
pub trait SessionMethods
  def prepared : PreparedQuery(self)
    PreparedQuery(self).new(self)
  end

  def unprepared : UnpreparedQuery(self)
    UnpreparedQuery(self).new(self)
  end
end

# The `QueryMethods` of a session *S* through prepared statements.
@[OnTape]
pub struct PreparedQuery(S)
  def initialize(@session : S)
  end

  def new_statement(query : String) : Statement
    @session.build_statement(query, true)
  end
end

impl QueryMethods for PreparedQuery(S) forall S
end

# The `QueryMethods` of a session *S* through unprepared statements.
@[OnTape]
pub struct UnpreparedQuery(S)
  def initialize(@session : S)
  end

  def new_statement(query : String) : Statement
    @session.build_statement(query, false)
  end
end

impl QueryMethods for UnpreparedQuery(S) forall S
end

# Statement methods that read the first row.
pub trait StatementMethods
  # Yields the first column of the first row.
  def scalar(*args_ : *T, args : Array(A)? = nil, & : DBValue -> U) : U | DBError forall T, A, U
    query(*args_, args: args) do |rs|
      return NoResultsError.new("no results") unless rs.move_next!
      value = rs.read!
      yield value
    end
  end

  # The first column of the first row, as the flat type *klass*.
  def scalar(*args_ : *T, args : Array(A)? = nil, as klass : K.class) : K | DBError forall T, A, K
    query(*args_, args: args) do |rs|
      return NoResultsError.new("no results") unless rs.move_next!
      rs.read(klass)!
    end
  end
end

# The block form of a transaction, on a connection and on a transaction.
pub trait BeginTransaction
  # Runs *tx*, already started, for the block: commits when the block ends,
  # rolls back when it is left early or answers an error. A `Rollback` answers
  # nil.
  private def run_transaction(tx : Transaction, & : Transaction -> T) : T | Nil | DBError forall T
    finished = false
    defer (tx.rollback if !finished && !tx.closed?)
    value = yield tx
    finished = true
    if value.is_a?(DBError)
      tx.rollback unless tx.closed?
      return nil if value.is_a?(Rollback)
      return value
    end
    tx.commit! unless tx.closed?
    value
  end
end

# The state of a connection's transaction, as its server reports it.
pub enum TransactionState
  Idle
  InTransaction
  FailedTransaction
end

# A connection: what a driver subclasses. One task opens it, uses it and closes
# it (SPEC 5.1).
#
# ### Note to implementors
#
# 1. Subclass `Connection`; `Driver#new_connection` builds it, doing no IO.
# 2. `#open` opens it and answers what kept it from opening, as
#    `ConnectionRefused`.
# 3. `#build_statement` builds a statement, doing no IO.
# 4. `#do_close` releases its resources.
pub abstract class Connection
  # How a connection runs its statements. Written out rather than with
  # `record`, whose struct is not `pub` and so not part of an artifact.
  pub struct Options
    getter prepared_statements : Bool

    def initialize(@prepared_statements : Bool = true)
    end

    def self.from_http_params(params : Params, default : Options = Options.new) : Options | DBError
      prepared_statements = fetch_bool(params, "prepared_statements", default.prepared_statements)!
      Options.new(prepared_statements: prepared_statements)
    end
  end

  @closed = false
  @transaction = false

  def initialize(@options : Options)
  end

  def prepared_statements? : Bool
    @options.prepared_statements
  end

  # Opens the connection. The default has nothing to open.
  def open : Nil | DBError
    nil
  end

  # A statement for *query*, prepared or not, doing no IO; `Statement#prepare`
  # answers what is wrong with it.
  abstract def build_statement(query : String, prepared : Bool) : Statement

  # A statement for *query* as this connection's options say.
  def new_statement(query : String) : Statement
    build_statement(query, prepared_statements?)
  end

  abstract def transaction_state : TransactionState

  abstract def driver_name : String

  def server_name : String?
    nil
  end

  def server_version : String?
    nil
  end

  # Yields this connection: the block runs on it. crystal-db's way of taking
  # one connection of a pool, for code that works on either.
  def using_connection(& : Connection -> U) : U | DBError forall U
    yield self
  end

  # Starts a transaction for the block. See `BeginTransaction`.
  def transaction(& : Transaction -> T) : T | Nil | DBError forall T
    return DBFailure.new("There is an existing transaction in this connection") if @transaction
    tx = TopLevelTransaction.new(self)
    tx.start!
    @transaction = true
    defer @transaction = false
    run_transaction(tx) { |t| yield t }
  end

  protected def do_close : Nil | DBError
    nil
  end

  def perform_begin_transaction : Nil | DBError
    run_unprepared("BEGIN")
  end

  def perform_commit_transaction : Nil | DBError
    run_unprepared("COMMIT")
  end

  def perform_rollback_transaction : Nil | DBError
    run_unprepared("ROLLBACK")
  end

  def perform_create_savepoint(name : String) : Nil | DBError
    run_unprepared("SAVEPOINT #{name}")
  end

  def perform_release_savepoint(name : String) : Nil | DBError
    run_unprepared("RELEASE SAVEPOINT #{name}")
  end

  def perform_rollback_savepoint(name : String) : Nil | DBError
    run_unprepared("ROLLBACK TO #{name}")
  end

  private def run_unprepared(sql : String) : Nil | DBError
    unprepared.exec(sql)!
    nil
  end
end

impl Disposable for Connection
end

impl QueryMethods for Connection
end

impl SessionMethods for Connection
end

impl BeginTransaction for Connection
end

# Where a program is used to a `Database` of connections; here each is one
# connection, and each task opens its own.
pub alias Database = Connection

# An execution of a query that answers no rows.
#
# ### Note to implementors
#
# 1. Subclass `Statement`; `Connection#build_statement` builds it.
# 2. `#prepare` readies it and answers what is wrong with its query.
# 3. `#perform_query` binds the arguments and starts the query, and
#    `#new_result_set` builds the set that reads it.
# 4. `#perform_exec` executes a query that answers an `ExecResult`.
# 5. `#do_close` releases the statement's resources.
pub abstract class Statement
  @closed = false
  getter connection : Connection
  getter command : String

  def initialize(@connection : Connection, @command : String)
  end

  # Readies the statement. The default has nothing to ready.
  def prepare : Nil | DBError
    nil
  end

  protected def do_close : Nil | DBError
    nil
  end

  # Executes the statement.
  def exec(*args_ : *T, args : Array(A)? = nil) : ExecResult | DBError forall T, A
    arrays = DBArrays.new
    bound = [] of DBValue
    collect_args(args_, args, bound, arrays)
    emit_log(bound, arrays)
    perform_exec(bound, arrays)
  end

  # Starts the query and yields its result set, closed when the block is left.
  def query(*args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : U | DBError forall T, A, U
    arrays = DBArrays.new
    bound = [] of DBValue
    collect_args(args_, args, bound, arrays)
    emit_log(bound, arrays)
    perform_query(bound, arrays)!
    rs = new_result_set
    defer rs.close
    yield rs
  end

  # Binds the arguments and starts the query. A `DBArray` in *args* has its
  # elements in *arrays*.
  protected abstract def perform_query(args : Array(DBValue), arrays : DBArrays) : Nil | DBError

  # The set that reads the query `perform_query` started.
  protected abstract def new_result_set : ResultSet

  protected abstract def perform_exec(args : Array(DBValue), arrays : DBArrays) : ExecResult | DBError

  protected def emit_log(args : Array(DBValue), arrays : DBArrays) : Nil
    # Tested first and not a block: a block given to the logger becomes a proc,
    # which may not capture the arguments on the tape.
    LOG.debug("Executing query -- query: #{command.inspect}, args: #{args_to_log(args, arrays)}") if LOG.debug?
  end
end

impl Disposable for Statement
end

impl StatementMethods for Statement
end

# The rows a query answered. See `Db::Db` for a complete sample.
#
# Each `#read` consumes a column and moves to the next one, so columns are
# read in order. `#move_next` may be called at any time, skipping the rest of
# the row, and the rows need not all be read.
#
# The result set closes when its query block is left.
#
# ### Note to implementors
#
# 1. Override `#move_next` to move to the next row.
# 2. Override `#read` returning the next value in the row.
# 3. (Optional) Override `#read(t)` for types `t` that need more than a cast.
# 4. Override `#column_count`, `#column_name` and `#next_column_index`.
pub abstract class ResultSet
  @closed = false
  getter statement : Statement

  def initialize(@statement : Statement)
  end

  protected def do_close : Nil | DBError
    nil
  end

  # Iterates over all the rows.
  def each(& : -> Nil) : Nil | DBError
    while move_next!
      yield
    end
    nil
  end

  # Iterates over all the column names.
  def each_column(& : String -> Nil) : Nil
    index = 0
    while index < column_count
      yield column_name(index)
      index += 1
    end
  end

  # Moves to the next row: `false` when there are no more.
  abstract def move_next : Bool | DBError

  # Returns the number of columns in the result.
  abstract def column_count : Int32

  # Returns the name of the column at the 0-based *index*.
  abstract def column_name(index : Int32) : String

  # Yields column names while their text is alive.
  def column_names(& : Array(String) -> U) : U forall U
    names = [] of String
    text = String::Builder.new
    each_column do |name|
      start = text.bytesize
      text << name
      names << text.finish[start, text.bytesize - start]
    end
    yield names
  end

  # Reads the next column value.
  abstract def read : DBValue | DBError

  # Reads the next column; a nested array's elements go to *arrays*, which
  # the caller owns and may clear between rows. A driver that answers nested
  # arrays overrides this; the default is `#read`.
  def read(arrays : DBArrays) : DBValue | DBError
    read
  end

  # Reads the next column with its text or bytes on the running fiber's
  # tape as a `String`; any other value as `#read` answers it. This
  # default copies the heap value `#read` makes; drivers override it to copy
  # the column's bytes straight onto the tape.
  def read_tape : String | DBValue | DBError
    value = read
    case value
    when String then String.new(value)
    when ::Std::Slice::Bytes
      writer = String::Builder.new(value.size)
      value.each { |byte| writer.push(byte) }
      writer.finish
    else
      value
    end
  end

  # The text of the next column; a type mismatch answers an error. A driver
  # writes these itself: text can leave a def only as its last call (SPEC 1.9),
  # which `read(klass)` cannot do after checking the type.
  abstract def read(t : String.class) : String | DBError

  # `read(String)`, with `nil` for a NULL column.
  abstract def read(t : (String | Nil).class) : String | Nil | DBError

  # The time in the next column, for a driver that has them.
  def read(t : ::Std::Time::Time.class) : ::Std::Time::Time | DBError
    DBFailure.new("#{self.class} does not read Time")
  end

  # `read(Time)`, with `nil` for a NULL column.
  def read(t : (::Std::Time::Time | Nil).class) : ::Std::Time::Time | Nil | DBError
    DBFailure.new("#{self.class} does not read Time")
  end

  # Returns the index of the column the next `#read` reads; `#column_count`
  # once the last column of the row has been read.
  abstract def next_column_index : Int32

  # Reads the next column value as a *type*.
  #
  # A `Tuple(...)` or `NamedTuple(...)` type reads one column per member, in
  # order, crystal-db's `read(String, Int32)` and `read(name: String, age:
  # Int32)`. An enum is read from a column holding its name or its value. A
  # type that derives `db_serializable` (or calls `mapping`) is read from the
  # columns of the current row. Anything else is the value itself, which must
  # be a *type*: `ColumnTypeMismatchError` when it is not.
  def read(klass : T.class) : T | DBError forall T
    # No `!` in this body: a generic body with macros in it is shipped in an
    # artifact as text, and read back without ris's `!` (ris 0.1.0).
    {% if T < ::Tuple %}
      {% for member, index in T.type_vars %}
        __iyi_db_column_{{ index }} = read({{ member }})
        return __iyi_db_column_{{ index }} if __iyi_db_column_{{ index }}.is_a?(DBError)
      {% end %}
      { {% for member, index in T.type_vars %} __iyi_db_column_{{ index }}, {% end %} }
    {% elsif T < ::NamedTuple %}
      {% for name, index in T.keys %}
        __iyi_db_column_{{ index }} = read({{ T[name] }})
        return __iyi_db_column_{{ index }} if __iyi_db_column_{{ index }}.is_a?(DBError)
      {% end %}
      { {% for name, index in T.keys %} {{ name }}: __iyi_db_column_{{ index }}, {% end %} }
    {% elsif T < ::Enum %}
      read_enum(klass)
    {% elsif T.class.has_method?(:from_db_row) %}
      T.from_db_row(self)
    {% else %}
      col_index = next_column_index
      value = read
      return value if value.is_a?(DBError)
      if value.is_a?(T)
        # `is_a?` narrows a single type and not a union such as `Int32?`, so
        # the value is cast; and a `.as(String?)` of a `DBValue` reads the
        # wrong bytes (ris 0.1.0), so a nilable type answers its nil here
        # and casts the rest to the type without `Nil`.
        {% if T.nilable? %}
          return nil if value.nil?
          value.as(typeof(value.as(T) || raise("")))
        {% else %}
          value.as(T)
        {% end %}
      else
        ColumnTypeMismatchError.new(
          context: "#{self.class}#read",
          column_index: col_index,
          column_name: column_name(col_index),
          column_type: value.class.to_s,
          expected_type: T.to_s
        )
      end
    {% end %}
  end

  # An enum from a column holding a member's name or value.
  private def read_enum(klass : T.class) : T | DBError forall T
    index = next_column_index
    value = read
    return value if value.is_a?(DBError)
    case value
    when String
      T.parse?(value) || ArgumentError.new("Unknown enum #{T} value: #{value}")
    when Int
      T.from_value?(value) || ArgumentError.new("Unknown enum #{T} value: #{value}")
    else
      ColumnTypeMismatchError.new(
        context: "#{T}.new(rs : ResultSet)",
        column_index: index,
        column_name: column_name(index),
        column_type: value.class.to_s,
        expected_type: "String | Int",
      )
    end
  end
end

impl Disposable for ResultSet
end

# A transaction: `Connection#transaction` or, nested as a savepoint,
# `Transaction#transaction` yield it.
pub abstract class Transaction
  @closed = false
  @nested_transaction = false

  abstract def connection : Connection

  abstract def start : Nil | DBError

  protected abstract def perform_commit : Nil | DBError

  protected abstract def perform_rollback : Nil | DBError

  # Commits and closes it.
  def commit : Nil | DBError
    return DBFailure.new("Transaction already closed") if closed?
    performed = perform_commit
    closed = close
    performed.is_a?(DBError) ? performed : closed
  end

  # Rolls back and closes it.
  def rollback : Nil | DBError
    return DBFailure.new("Transaction already closed") if closed?
    performed = perform_rollback
    closed = close
    performed.is_a?(DBError) ? performed : closed
  end

  # Starts a savepoint for the block. See `BeginTransaction`.
  def transaction(& : Transaction -> T) : T | Nil | DBError forall T
    return DBFailure.new("There is an existing nested transaction in this transaction") if @nested_transaction
    tx = SavePointTransaction.new(connection, next_savepoint)
    tx.start!
    @nested_transaction = true
    defer @nested_transaction = false
    run_transaction(tx) { |t| yield t }
  end

  # A number that names a savepoint no other one on this connection has.
  protected abstract def next_savepoint : Int32

  protected def do_close : Nil | DBError
    nil
  end
end

impl Disposable for Transaction
end

impl BeginTransaction for Transaction
end

pub class TopLevelTransaction < Transaction
  getter connection : Connection
  @savepoint_count = 0

  def initialize(@connection : Connection)
  end

  def start : Nil | DBError
    @connection.perform_begin_transaction
  end

  protected def perform_commit : Nil | DBError
    @connection.perform_commit_transaction
  end

  protected def perform_rollback : Nil | DBError
    @connection.perform_rollback_transaction
  end

  protected def next_savepoint : Int32
    @savepoint_count += 1
    @savepoint_count
  end
end

pub class SavePointTransaction < Transaction
  getter connection : Connection
  getter savepoint : Int32
  @next = 0

  def initialize(@connection : Connection, @savepoint : Int32)
  end

  # The savepoint's name in SQL.
  def savepoint_name : String
    "ris_sp_#{@savepoint}"
  end

  def start : Nil | DBError
    @connection.perform_create_savepoint(savepoint_name)
  end

  protected def perform_commit : Nil | DBError
    @connection.perform_release_savepoint(savepoint_name)
  end

  protected def perform_rollback : Nil | DBError
    @connection.perform_rollback_savepoint(savepoint_name)
  end

  # Unique among the savepoints under this one: 1000 per level.
  protected def next_savepoint : Int32
    @next += 1
    @savepoint * 1000 + @next
  end
end

# Database driver implementors subclass `Driver`, register it with a driver name
# using `Db::Db.register_driver` and implement `#new_connection`.
#
# ### Example
#
# ```
# import db/db/db
# import db/db/core::*
# import std/uri::{ParsedURI, URI}
#
# class FakeDriver < Driver
#   def new_connection(uri : URI | ParsedURI, options : Connection::Options) : Connection
#     FakeConnection.new(options, uri)
#   end
# end
#
# Db::Db.register_driver "fake", FakeDriver
#
# Db::Db.open("fake://...") { |db| ... }
# ```
pub abstract class Driver
  def initialize
  end

  # A connection to *uri*, doing no IO: `Connection#open` opens it. *uri* lives
  # as long as the connection; a driver may keep it and parse it in `open`.
  abstract def new_connection(uri : URI | ParsedURI, options : Connection::Options) : Connection

  # The options in the query of a URI.
  def connection_options(params : Params) : Connection::Options | DBError
    Connection::Options.from_http_params(params)
  end
end
