# crystal-db's spec/connection_spec.cr.
module db/connection_test

import db/core::*
import db/spec::{describe, it}
import db/testing/dummy_driver::*

describe "Connection" do
  it "raises on #driver_name if the driver doesn't override it" do
    with_dummy_connection do |cnn|
      assert cnn.driver_name == "dummy"
    end
  end

  it "returns nil for #server_name if the driver doesn't override it" do
    with_dummy_connection do |cnn|
      assert cnn.server_name.nil?
    end
  end

  it "returns nil for #server_version if the driver doesn't override it" do
    with_dummy_connection do |cnn|
      assert cnn.server_version.nil?
    end
  end
end

# Exercise the public contract through the abstract connection type.
def state_of(connection : Connection) : TransactionState
  connection.transaction_state
end

with_dummy_connection do |cnn|
  assert state_of(cnn) == TransactionState::Idle
  cnn.transaction_state = TransactionState::InTransaction
  assert state_of(cnn) == TransactionState::InTransaction
  cnn.transaction_state = TransactionState::FailedTransaction
  assert state_of(cnn) == TransactionState::FailedTransaction
end
