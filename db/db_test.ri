# crystal-db's spec/db_spec.cr.
module db/db_test

import std/uri::{Params}
import db/db
import db/errors::*
import db/core::*
import db/query_params::{fetch_bool}
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

describe "Db" do
  it "keeps error messages flat and bounded" do
    error = DBFailure.new("x" * 300)
    assert error.message.bytesize == 240
    assert error.message == "x" * 240
  end

  it "should get driver class by name" do
    assert ::Db::Db.driver_class("dummy").or_panic.to_s == DummyDriver.to_s
  end

  {% for method in [:open, :connect] %}
    it "{{method.id}} creates one connection and closes it" do
      opened = DummyConnection.connections_count
      closed = DummyConnection.closed_count
      ::Db::Db.{{method.id}}("dummy://localhost") do |cnn|
        assert cnn.is_a?(DummyConnection)
        assert !cnn.closed?
        assert DummyConnection.connections_count == opened + 1
        assert DummyConnection.closed_count == closed
      end.or_panic
      assert DummyConnection.closed_count == closed + 1
    end
  {% end %}

  it "query should close result_set on break" do
    with_dummy do |db|
      closed = DummyResultSet.closed_count
      db.query("1,2") { |rs| break }
      assert DummyResultSet.closed_count == closed + 1
    end
  end

  it "scalar should close statement and result set" do
    with_dummy do |db|
      statements = DummyStatement.closed_count
      results = DummyResultSet.closed_count
      assert db.scalar("1", as: Int64).or_panic == 1
      assert DummyStatement.closed_count == statements + 1
      assert DummyResultSet.closed_count == results + 1
    end
  end

  it "sequential calls use the same open connection" do
    with_dummy do |db|
      count = DummyConnection.connections_count
      db.exec("foo").or_panic
      db.exec("bar").or_panic
      db.scalar("foo") { |v| assert v == "foo" }.or_panic
      db.scalar("bar") { |v| assert v == "bar" }.or_panic
      assert DummyConnection.connections_count == count
      assert !db.closed?
    end
  end

  it "gives nice error message when no driver is registered for schema (#21)" do
    expect_error(::Db::Db.open("foobar://baz") { |_| }, ArgumentError, %(no driver was registered for the schema "foobar", did you maybe forget to require the database driver?))
  end

  it "should parse boolean query string params" do
    assert fetch_bool(Params.parse("foo=true"), "foo", false).or_panic
    assert fetch_bool(Params.parse("foo=True"), "foo", false).or_panic

    assert !fetch_bool(Params.parse("foo=false"), "foo", true).or_panic
    assert !fetch_bool(Params.parse("foo=False"), "foo", true).or_panic

    assert !fetch_bool(Params.parse("bar=true"), "foo", false).or_panic
    assert fetch_bool(Params.parse("bar=true"), "foo", true).or_panic

    expect_error(fetch_bool(Params.parse("foo=other"), "foo", true), ArgumentError, %(invalid "other" value for option "foo"))
  end
end
