# crystal-db's spec/result_set_spec.cr.
module db/result_set_test

import db/errors::*
import db/core::*
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

describe "ResultSet" do
  it "should enumerate records using each" do
    nums = [] of Int32

    with_dummy do |db|
      db.query "3,4 1,2" do |rs|
        rs.each do
          nums << rs.read(Int32).or_panic
          nums << rs.read(Int32).or_panic
        end.or_panic
      end.or_panic
    end

    assert nums == [3, 4, 1, 2]
  end

  it "should close ResultSet after query" do
    with_dummy do |db|
      before = DummyResultSet.closed_count
      db.query "3,4 1,2" do |rs|
        assert !rs.closed?
      end.or_panic
      assert DummyResultSet.closed_count == before + 1
    end
  end

  it "should close ResultSet after query even with exception" do
    with_dummy do |db|
      before = DummyResultSet.closed_count
      # no exceptions in ris: the block answers an error value instead of raising
      res = db.query "3,4 1,2" do |rs|
        assert !rs.closed?
        DBFailure.new("dummy")
      end
      expect_error(res, DBError, "dummy")
      assert DummyResultSet.closed_count == before + 1

      # and leaving the block early
      before = DummyResultSet.closed_count
      db.query "3,4 1,2" do |rs|
        assert !rs.closed?
        break
      end
      assert DummyResultSet.closed_count == before + 1
    end
  end

  it "should enumerate columns" do
    count = 0

    with_dummy do |db|
      db.query "3,4 1,2" do |rs|
        rs.each_column do |col|
          assert col == (count == 0 ? "c0" : "c1")
          count += 1
        end
      end.or_panic
    end

    assert count == 2
  end

  it "gets all column names" do
    with_dummy do |db|
      db.query "1,2" do |rs|
        rs.column_names { |names| assert names == ["c0", "c1"] }
      end.or_panic
    end
  end
end
