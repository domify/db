# The driver the tests run against, registered as "dummy": crystal-db's
# `spec/dummy_driver.cr` and the helpers of `spec/spec_helper.cr`.
#
# A query's text is its result: rows separated by spaces, columns by
# commas. `"3,4 1,2"` answers two rows of two columns, `NULL` is a nil, and a
# column that reads as an integer is an `Int64`. A few queries misbehave on
# purpose: `"syntax error"` cannot be prepared, `"raise ConnectionLost"` loses
# the connection, and an exec of `"raise"` fails.
module db/testing/dummy_driver

import std/uri::{ParsedURI, URI, Params}
import std/static_array
import std/text
import std/slice::{Slice, Bytes}
import db/db
import db/errors::*
import db/value::*
import db/core::*

pub class DummyDriver < Driver
  def new_connection(uri : URI | ParsedURI, options : Connection::Options) : Connection
    DummyConnection.new(options)
  end
end

pub class DummyConnection < Connection
  @@connections_count = 0

  @@closed_count = 0
  def self.closed_count : Int32
    @@closed_count
  end

  property commits = 0
  property rollbacks = 0
  property releases = 0
  property savepoint_rollbacks = 0

  def perform_commit_transaction : Nil | DBError
    @commits += 1
    nil
  end

  def perform_rollback_transaction : Nil | DBError
    @rollbacks += 1
    nil
  end

  def perform_release_savepoint(name : String) : Nil | DBError
    @releases += 1
    nil
  end

  def perform_rollback_savepoint(name : String) : Nil | DBError
    @savepoint_rollbacks += 1
    nil
  end

  protected def do_close : Nil | DBError
    @@closed_count += 1
    @connected = false
    nil
  end

  @connected = true

  def initialize(options : Connection::Options)
    super(options)
    @@connections_count += 1
  end

  def self.connections_count : Int32
    @@connections_count
  end

  def build_statement(query : String, prepared : Bool) : Statement
    DummyStatement.new(self, query, prepared)
  end

  property transaction_state : TransactionState = TransactionState::Idle

  def driver_name : String
    "dummy"
  end

  def last_insert_id : Int64
    0_i64
  end

  def check : Nil | DBError
    return ConnectionLost.new("connection lost") unless @connected
    nil
  end

  def disconnect : Nil
    @connected = false
  end
end

pub class DummyStatement < Statement
  @@statements_count = 0
  @@statements_exec_count = 0

  def initialize(connection : Connection, command : String, @prepared : Bool)
    super(connection, command)
    @@statements_count += 1
  end

  def self.statements_count : Int32
    @@statements_count
  end

  def self.statements_exec_count : Int32
    @@statements_exec_count
  end


  @params_bytes = StaticArray(UInt8, 512).new(0_u8)
  @params_size = 0

  def params_log : String
    String.build(@params_size) { |writer| @params_size.times { |i| writer.push(@params_bytes[i]) } }
  end

  private def record_params(args : Array(DBValue), arrays : DBArrays) : Nil
    text = args_to_log(args, arrays)
    raise "dummy argument log too long" if text.bytesize > 512
    @params_size = text.bytesize
    @params_size.times { |i| @params_bytes[i] = text.byte_at(i) }
  end

  protected def do_close : Nil | DBError
    @@closed_count += 1
    nil
  end

  @@closed_count = 0
  def self.closed_count : Int32
    @@closed_count
  end

  # crystal-db's statement raised these from its constructor.
  def prepare : Nil | DBError
    return DBFailure.new(command) if command == "syntax error"
    return ConnectionLost.new("connection lost") if command == "raise ConnectionLost"
    nil
  end

  def query(*args_ : *T, args : Array(A)? = nil, & : ResultSet -> U) : U | DBError forall T, A, U
    arrays = DBArrays.new
    bound = [] of DBValue
    collect_args(args_, args, bound, arrays)
    emit_log(bound, arrays)
    perform_query(bound, arrays)!
    rs = DummyResultSet.new(self, command, bound)
    defer rs.close
    yield rs
  end

  protected def perform_query(args : Array(DBValue), arrays : DBArrays) : Nil | DBError
    assert_not_closed
    record_params(args, arrays)
    @@statements_exec_count += 1
    @connection.as(DummyConnection).check
  end

  protected def new_result_set : ResultSet
    DummyResultSet.new(self, command)
  end

  protected def perform_exec(args : Array(DBValue), arrays : DBArrays) : ExecResult | DBError
    assert_not_closed
    record_params(args, arrays)
    @@statements_exec_count += 1
    @connection.as(DummyConnection).check!
    return DBFailure.new("forced exception due to query") if command == "raise"
    ExecResult.new 0_i64, 0_i64
  end

  def prepared? : Bool
    @prepared
  end

  private def assert_not_closed : Nil
    raise "Statement is closed" if closed?
  end
end

# Reads the rows out of the query's text, which it scans as it goes: spaces
# between rows and commas between columns.
pub class DummyResultSet < ResultSet
  @@closed_count = 0
  def self.closed_count : Int32
    @@closed_count
  end

  protected def do_close : Nil | DBError
    @@closed_count += 1
    nil
  end

  @command : String
  @row_at = 0
  @row_end = -1
  @cell_at = 0
  @column = 0

  def initialize(statement : Statement, @command : String, @bound : Array(DBValue)? = nil)
    super(statement)
  end

  def move_next : Bool | DBError
    return false if @row_end >= @command.bytesize
    @row_at = @row_end + 1
    return false if @row_at >= @command.bytesize
    @row_end = @command.byte_index(" ", @row_at) || @command.bytesize
    @cell_at = @row_at
    @column = 0
    true
  end

  def column_count : Int32
    first_row_end = @command.byte_index(" ", 0) || @command.bytesize
    commas = 0
    first_row_end.times { |index| commas += 1 if @command.byte_at(index) == 44_u8 }
    commas + 1
  end

  def column_name(index : Int32) : String
    "c#{index}"
  end

  # The next cell's text, a view of the query.
  private def next_cell : String
    raise "end of row" if @cell_at > @row_end
    stop = @command.byte_index(",", @cell_at) || @row_end
    stop = @row_end if stop > @row_end
    start = @cell_at
    @cell_at = stop + 1
    @column += 1
    @command[start, stop - start]
  end

  def read : DBValue | DBError
    if @command == "?"
      if bound = @bound
        return bound[0]
      end
    end
    cell = next_cell
    return nil if cell == "NULL"
    cell.to_i64? || cell
  end

  def next_column_index : Int32
    @column
  end

  def read(t : String.class) : String | DBError
    cell = next_cell
    return DBFailure.new("NULL is no String") if cell == "NULL"
    cell
  end

  # `(String | Nil).class`, not `String?.class`: ris 0.1.0 writes the short
  # spelling into an artifact as `String | ::Nil.class`, which matches
  # nothing.
  def read(t : (String | Nil).class) : String? | DBError
    cell = next_cell
    cell == "NULL" ? nil : cell
  end

  def read(t : Int32.class) : Int32 | DBError
    text = read(String)!
    text.to_i? || ArgumentError.new("Invalid Int32: #{text.inspect}")
  end

  def read(t : (Int32 | Nil).class) : Int32? | DBError
    text = read(String?)!
    return nil if text.nil?
    text.to_i? || ArgumentError.new("Invalid Int32: #{text.inspect}")
  end

  def read(t : Int64.class) : Int64 | DBError
    text = read(String)!
    text.to_i64? || ArgumentError.new("Invalid Int64: #{text.inspect}")
  end

  def read(t : (Int64 | Nil).class) : Int64? | DBError
    text = read(String?)!
    return nil if text.nil?
    text.to_i64? || ArgumentError.new("Invalid Int64: #{text.inspect}")
  end

  def read(t : Bytes.class) : Bytes | DBError
    bytes_of(next_cell)
  end

  private def bytes_of(cell : String) : Bytes
    Bytes.new(cell.bytesize) { |i| cell.byte_at(i) }
  end

  def read(t : Float32.class) : Float32 | DBError
    text = read(String)!
    parsed = text.to_f?
    return ArgumentError.new("Invalid Float32: #{text.inspect}") if parsed.nil?
    parsed.to_f32
  end

  def read(t : Float64.class) : Float64 | DBError
    text = read(String)!
    text.to_f? || ArgumentError.new("Invalid Float64: #{text.inspect}")
  end
end

::Db::Db.register_driver "dummy", DummyDriver

# Counts down the checks an example expects, so a block that should have
# run and did not fails the example.
pub class Witness
  getter count : Int32

  def initialize(@count : Int32 = 1)
  end

  def check : Nil
    @count -= 1
  end
end

pub def with_witness(count : Int32 = 1, & : Witness -> Nil) : Nil
  w = Witness.new(count)
  yield w
  assert w.count == 0, "The expected coverage was unmet"
end

pub def with_dummy(uri : String = "dummy://host?", & : Database -> Nil) : Nil
  ::Db::Db.open(uri) { |db| yield db }.or_panic
end

pub def with_dummy_connection(options : String = "", & : DummyConnection -> Nil) : Nil
  with_dummy("dummy://host?#{options}") do |db|
    db.using_connection { |cnn| yield cnn.as(DummyConnection) }.or_panic
  end
end
