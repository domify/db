module db/transaction_test

import db/errors::*
import db/core::*
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

struct FooError < DBError
  def initialize
    super("foo")
  end
end

def leave_transaction(cnn : Connection, commit : Bool) : Nil | DBError
  cnn.transaction do |tx|
    tx.commit! if commit
    return nil
  end
end

describe "Transaction" do
  it "begin/commit transaction from connection" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.commit.or_panic
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 1
      assert cnn.rollbacks == 0
    end
  end

  it "begin/rollback transaction from connection" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.rollback.or_panic
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "transaction with block from connection should be committed" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        nil
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 1
      assert cnn.rollbacks == 0
    end
  end

  it "transaction with block from connection should be rolledback if raise DB::Rollback" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        Rollback.new
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "transaction with block from connection should be rolledback if raise" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        FooError.new
      end
      assert seen
      expect_error(result, FooError, "foo")
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "transaction can be committed within block" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.commit.or_panic
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 1
      assert cnn.rollbacks == 0
    end
  end

  it "transaction can be rolledback within block" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.rollback.or_panic
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "transaction can be rolledback within block and later raise" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.rollback.or_panic
        FooError.new
      end
      assert seen
      expect_error(result, FooError, "foo")
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "transaction can be rolledback within block and later raise DB::Rollback without forwarding it" do
    with_dummy_connection do |cnn|
      seen = false
      result = cnn.transaction do |tx|
        seen = true
        assert tx.connection == cnn
        tx.rollback.or_panic
        Rollback.new
      end
      assert seen
      assert result.nil?
      assert cnn.commits == 0
      assert cnn.rollbacks == 1
    end
  end

  it "raise if begin over existing transaction" do
    with_dummy_connection do |cnn|
      cnn.transaction do |tx|
        expect_error(cnn.transaction { |_| }, DBError, "There is an existing transaction in this connection")
        nil
      end.or_panic
    end
  end

  it "allow sequential transactions" do
    with_dummy_connection do |cnn|
      cnn.transaction { |tx| tx.rollback }.or_panic
      cnn.transaction { |tx| tx.commit }.or_panic
      assert cnn.commits == 1
      assert cnn.rollbacks == 1
    end
  end

  {% for commit in [false, true] %}
    it "early return with explicit commit {{commit}}" do
      with_dummy_connection do |cnn|
        leave_transaction(cnn, {{commit}}).or_panic
        assert cnn.commits == ({{commit}} ? 1 : 0)
        assert cnn.rollbacks == ({{commit}} ? 0 : 1)
      end
    end
  {% end %}

  {% for method in [:commit, :rollback] %}
    it "transaction can't be {{method.id}} twice" do
      with_dummy_connection do |cnn|
        cnn.transaction do |tx|
          tx.{{method.id}}.or_panic
          expect_error(tx.{{method.id}}, DBError, "Transaction already closed")
          nil
        end.or_panic
      end
    end
  {% end %}

  it "returns block value when success" do
    with_dummy_connection do |cnn|
      result = cnn.transaction { |_| 42 }
      assert result.or_panic == 42
      assert typeof(result).to_s == (Int32 | Nil | DBError).to_s
      assert cnn.commits == 1
    end
  end

  it "returns value on rollback via method" do
    with_dummy_connection do |cnn|
      result = cnn.transaction do |tx|
        tx.rollback.or_panic
        42
      end
      assert result.or_panic == 42
      assert typeof(result).to_s == (Int32 | Nil | DBError).to_s
      assert cnn.rollbacks == 1
    end
  end

  it "returns nil on rollback via error" do
    with_dummy_connection do |cnn|
      result = cnn.transaction { |_| true ? Rollback.new : 42 }
      assert result.nil?
      assert typeof(result).to_s == (Int32 | Nil | DBError).to_s
      assert cnn.rollbacks == 1
    end
  end
end
