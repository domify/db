# crystal-db's spec/statement_spec.cr.
module db/statement_test

import std/log::{Log, RisMemoryBackend, Severity}
import db/db
import db/errors::*
import db/core::*
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

# The debug entries LOG wrote while running the block.
def capture_log(& : -> Nil) : Array(String)
  backend = RisMemoryBackend.on_program
  LOG.backend = backend
  previous_level = LOG.level
  LOG.level = Severity::Debug
  defer LOG.backend = nil
  defer LOG.level = previous_level
  yield
  backend.entries.select { |e| e.severity == Severity::Debug }.map { |e| e.message }
end

describe "Statement" do
  it "should build prepared statements" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      assert stmt.is_a?(Statement)
      assert stmt.as(DummyStatement).prepared?
      end.or_panic
    end
  end

  it "should build unprepared statements" do
    with_dummy_connection("prepared_statements=false") do |cnn|
      cnn.unprepared.with_statement("the query") do |stmt|
      assert stmt.is_a?(Statement)
      assert !stmt.as(DummyStatement).prepared?
      end.or_panic
    end
  end

  describe "prepared_statements flag" do
    it "should build prepared statements if true" do
      with_dummy_connection("prepared_statements=true") do |cnn|
        cnn.query("the query") { |rs| assert rs.statement.as(DummyStatement).prepared? }.or_panic
      end
    end

    it "should build unprepared statements if false" do
      with_dummy_connection("prepared_statements=false") do |cnn|
        cnn.query("the query") { |rs| assert !rs.statement.as(DummyStatement).prepared? }.or_panic
      end
    end
  end

  it "creates a fresh statement for every query" do
    with_dummy_connection do |cnn|
      count = DummyStatement.statements_count
      closed = DummyStatement.closed_count
      2.times do
        cnn.query("the query") do |rs|
          assert !rs.statement.closed?
        end.or_panic
      end
      assert DummyStatement.statements_count == count + 2
      assert DummyStatement.closed_count == closed + 2
    end
  end

  it "should initialize positional params in query" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.query("a", 1, nil) { }.or_panic
      assert stmt.as(DummyStatement).params_log == %(["a", 1, nil])
      end.or_panic
    end
  end

  it "accepts array as single argument" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.query(["a", 1, nil]) { }.or_panic
      assert stmt.as(DummyStatement).params_log == %([["a", 1, nil]])
      end.or_panic
    end
  end

  it "allows no arguments" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.query { }.or_panic
      assert stmt.as(DummyStatement).params_log == "[]"
      end.or_panic
    end
  end

  it "concatenate arguments" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.query(1, 2, args: ["a", nil]) { }.or_panic
      assert stmt.as(DummyStatement).params_log == %([1, 2, "a", nil])
      end.or_panic
    end
  end

  it "should initialize positional params in query with array" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.query(args: ["a", 1, nil]) { }.or_panic
      assert stmt.as(DummyStatement).params_log == %(["a", 1, nil])
      end.or_panic
    end
  end

  it "should initialize positional params in exec" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.exec("a", 1, nil).or_panic
      assert stmt.as(DummyStatement).params_log == %(["a", 1, nil])
      end.or_panic
    end
  end

  it "accepts array as single argument" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.exec(["a", 1, nil]).or_panic
      assert stmt.as(DummyStatement).params_log == %([["a", 1, nil]])
      end.or_panic
    end
  end

  it "should initialize positional params in exec with array" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.exec(args: ["a", 1, nil]).or_panic
      assert stmt.as(DummyStatement).params_log == %(["a", 1, nil])
      end.or_panic
    end
  end

  it "allows no arguments" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.exec.or_panic
      assert stmt.as(DummyStatement).params_log == "[]"
      end.or_panic
    end
  end

  it "concatenate arguments" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.exec(1, 2, args: ["a", nil]).or_panic
      assert stmt.as(DummyStatement).params_log == %([1, 2, "a", nil])
      end.or_panic
    end
  end

  it "should initialize positional params in scalar" do
    with_dummy_connection do |cnn|
      cnn.with_statement("the query") do |stmt|
      stmt.scalar("a", 1, nil) { |_| }.or_panic
      assert stmt.as(DummyStatement).params_log == %(["a", 1, nil])
      end.or_panic
    end
  end

  it "query with block should not close statement" do
    with_dummy_connection do |cnn|
      cnn.with_statement("3,4 1,2") do |stmt|
      stmt.query { }.or_panic
      assert !stmt.closed?
      end.or_panic
    end
  end

  it "statement block should close statement" do
    with_dummy_connection do |cnn|
      before = DummyStatement.closed_count
      cnn.with_statement("3,4 1,2") { |stmt| stmt.query { }.or_panic }.or_panic
      assert DummyStatement.closed_count == before + 1
    end
  end

  it "query with block should not close statement" do
    with_dummy_connection do |cnn|
      cnn.with_statement("3,4 1,2") do |stmt|
      stmt.query do |rs|
      end.or_panic
      assert !stmt.closed?
      end.or_panic
    end
  end

  it "query should not close statement" do
    with_dummy_connection do |cnn|
      cnn.with_statement("3,4 1,2") do |stmt|
      stmt.query do |rs|
      end.or_panic
      assert !stmt.closed?
      end.or_panic
    end
  end

  it "scalar should not close statement" do
    with_dummy_connection do |cnn|
      cnn.with_statement("3,4 1,2") do |stmt|
      stmt.scalar { |_| }.or_panic
      assert !stmt.closed?
      end.or_panic
    end
  end

  it "exec should not close statement" do
    with_dummy_connection do |cnn|
      cnn.with_statement("3,4 1,2") do |stmt|
      stmt.exec.or_panic
      assert !stmt.closed?
      end.or_panic
    end
  end


  it "connection remains usable after an exec error" do
    with_dummy do |db|
      expect_error(db.exec("raise"), DBError)
      assert !db.closed?
      db.exec("ok").or_panic
    end
  end

  it "raises NoResultsError for scalar" do
    with_dummy_connection do |cnn|
      cnn.with_statement("") do |stmt|
      expect_error(stmt.scalar("SELECT LIMIT 0") { |_| }, NoResultsError)
      nil
      end.or_panic
    end
  end

  # crystal checks the entries' structured data; ris's log entries carry the
  # rendered message (`Executing query -- query: "42", args: []`).
  describe "logging" do
    it "exec with no arguments" do
      messages = capture_log do
        with_dummy do |db|
          db.exec("42").or_panic
        end
      end

      entries = messages.select(&.includes?("Executing query"))
      assert entries.size >= 1
      assert entries[0] == %(Executing query -- query: "42", args: [])
    end

    it "query with arguments" do
      messages = capture_log do
        with_dummy do |db|
          db.exec("1, ?", args: ["a"]).or_panic
          db.exec("2, ?", "a").or_panic
          db.exec("3, ?", ["a"]).or_panic
        end
      end

      entries = messages.select(&.includes?("Executing query"))
      assert entries.size == 3
      assert entries[0] == %(Executing query -- query: "1, ?", args: ["a"])
      assert entries[1] == %(Executing query -- query: "2, ?", args: ["a"])
      assert entries[2] == %(Executing query -- query: "3, ?", args: [["a"]])
    end
  end

end
