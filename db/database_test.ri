module db/database_test

import db/db
import db/errors::*
import db/core::*
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

describe "Database" do
  it "allows multiple statements on one connection" do
    with_dummy do |db|
      count = DummyConnection.connections_count
      db.with_statement("query1") do |first|
        db.with_statement("query2") do |second|
          db.with_statement("query3") do |third|
            assert first != second && second != third && first != third
            assert first.connection == db && second.connection == db && third.connection == db
          end.or_panic
        end.or_panic
      end.or_panic
      assert DummyConnection.connections_count == count
    end
  end

  it "reports connection loss without reconnecting" do
    with_dummy do |db|
      count = DummyConnection.connections_count
      db.exec("stmt1").or_panic
      db.as(DummyConnection).disconnect
      expect_error(db.exec("stmt1"), ConnectionLost)
      assert DummyConnection.connections_count == count
    end
  end

  it "does not open another connection on a statement error" do
    with_dummy do |db|
      count = DummyConnection.connections_count
      expect_error(db.exec("syntax error"), DBError, "syntax error")
      assert DummyConnection.connections_count == count
    end
  end

  {% for prepared in [:prepared, :unprepared] %}
    it "closes a failed {{prepared.id}} statement and keeps the connection usable" do
      with_dummy do |db|
        before = DummyStatement.closed_count
        expect_error(db.{{prepared.id}}.exec("syntax error"), DBError, "syntax error")
        assert DummyStatement.closed_count == before + 1
        assert !db.closed?
        db.exec("ok").or_panic
      end
    end
  {% end %}

  it "opens a connection inside each task" do
    before = DummyConnection.connections_count
    closed = DummyConnection.closed_count
    group do |g|
      3.times do
        g.spawn do
          ::Db::Db.open("dummy://host") do |db|
            assert !db.closed?
            assert db.scalar("1", as: Int64).or_panic == 1
          end.or_panic
          0
        end
      end
    end
    assert DummyConnection.connections_count == before + 3
    assert DummyConnection.closed_count == closed + 3
  end


  describe "prepared_statements connection option" do
    it "defaults to true" do
      with_dummy "dummy://localhost:1027" do |db|
        assert db.prepared_statements?
      end
    end

    it "can be set to false" do
      with_dummy "dummy://localhost:1027?prepared_statements=false" do |db|
        assert !db.prepared_statements?
      end
    end

    it "is copied to connections (false)" do
      with_dummy "dummy://localhost:1027?prepared_statements=false" do |db|
        assert !db.prepared_statements?
      end
    end

    it "is copied to connections (true)" do
      with_dummy "dummy://localhost:1027?prepared_statements=true" do |db|
        assert db.prepared_statements?
      end
    end

    it "should build prepared statements if true" do
      with_dummy "dummy://localhost:1027?prepared_statements=true" do |db|
        db.with_statement("the query") { |stmt| assert stmt.as(DummyStatement).prepared? }.or_panic
      end
    end

    it "should build unprepared statements if false" do
      with_dummy "dummy://localhost:1027?prepared_statements=false" do |db|
        db.with_statement("the query") { |stmt| assert !stmt.as(DummyStatement).prepared? }.or_panic
      end
    end

    it "should be overrided by dsl" do
      with_dummy "dummy://localhost:1027?prepared_statements=true" do |db|
        db.unprepared.query("the query") { |rs| assert !rs.statement.as(DummyStatement).prepared? }.or_panic
      end

      with_dummy "dummy://localhost:1027?prepared_statements=false" do |db|
        db.prepared.query("the query") { |rs| assert rs.statement.as(DummyStatement).prepared? }.or_panic
      end
    end
  end

end
