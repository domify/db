# The errors of database calls.
#
# `DBError` is a flat struct: its message sits in the struct, cut off at
# `MESSAGE_SIZE` bytes, and nothing of it is on a tape. So `!` carries it out of
# any def or block, and it needs no copy to outlive the scope that made it
# (SPEC 1.1). A driver's own error is a struct under it, as `SQLite3Error` is.
module db/errors

import std/static_array

pub abstract struct DBError
  MESSAGE_SIZE = 240

  @message_bytes : StaticArray(UInt8, 240)
  @message_size : Int32

  def initialize(message : String = "")
    @message_bytes = StaticArray(UInt8, 240).new(0_u8)
    @message_size = message.bytesize < MESSAGE_SIZE ? message.bytesize : MESSAGE_SIZE
    index = 0
    while index < @message_size
      @message_bytes[index] = message.byte_at(index)
      index += 1
    end
  end

  # The message, on the caller's tape.
  def message : String
    String.build(@message_size) { |writer| @message_size.times { |index| writer.push(@message_bytes[index]) } }
  end

  def to_s : String
    message
  end

  def inspect : String
    "#<#{self.class}: #{message}>"
  end
end

impl Error for DBError
end

# A failure with nothing more to say than its message.
pub struct DBFailure < DBError
end

# A row could not be read into a type.
pub struct MappingError < DBError
end

# The connection could not be opened.
pub struct ConnectionRefused < DBError
end

# The connection went away while it was in use.
pub struct ConnectionLost < DBError
end

# Answered from a `transaction` block, rolls it back and answers nil.
pub struct Rollback < DBError
end

# A query that had to answer a row did not.
pub struct NoResultsError < DBError
end

# A column does not hold the type it was read as.
pub struct ColumnTypeMismatchError < DBError
  getter column_index : Int32

  def initialize(*, context : String, @column_index : Int32, column_name : String, column_type : String, expected_type : String)
    super("In #{context} the column #{column_name} returned a #{column_type} but a #{expected_type} was expected.")
  end
end

# An argument the call cannot take.
pub struct ArgumentError < DBError
end
