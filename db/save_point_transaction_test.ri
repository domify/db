module db/save_point_transaction_test

import db/errors::*
import db/core::*
import db/spec::{describe, it, expect_error}
import db/testing/dummy_driver::*

def with_dummy_top_transaction(& : Transaction, DummyConnection -> Nil) : Nil
  with_dummy_connection do |cnn|
    cnn.transaction { |tx| yield tx, cnn }.or_panic
    assert cnn.commits == 1
    assert cnn.rollbacks == 0
  end
end

def with_dummy_nested_transaction(& : Transaction, DummyConnection -> Nil) : Nil
  with_dummy_connection do |cnn|
    released = 0
    cnn.transaction do |tx|
      tx.transaction do |nested|
        yield nested, cnn
        released = cnn.releases
      end.or_panic
      assert cnn.releases == released + 1
    end.or_panic
    assert cnn.commits == 1
    assert cnn.rollbacks == 0
  end
end

describe "SavePointTransaction" do
  {% for context in [:with_dummy_top_transaction, :with_dummy_nested_transaction] %}
    describe "{{context.id}}" do
      {% for method in [:commit, :rollback] %}
        it "begin/{{method.id}} transaction from parent transaction" do
          {{context.id}} do |parent, cnn|
            releases = cnn.releases
            rollbacks = cnn.savepoint_rollbacks
            parent.transaction do |tx|
              assert tx.is_a?(SavePointTransaction)
              assert tx.connection == cnn
              tx.{{method.id}}.or_panic
            end.or_panic
            assert cnn.releases == releases + ({{method == :commit}} ? 1 : 0)
            assert cnn.savepoint_rollbacks == rollbacks + ({{method == :rollback}} ? 1 : 0)
          end
        end
      {% end %}

      it "raise if begin over existing transaction" do
        {{context.id}} do |parent, cnn|
          parent.transaction do |tx|
            expect_error(parent.transaction { |_| }, DBError, "There is an existing nested transaction in this transaction")
            nil
          end.or_panic
        end
      end

      it "allow sequential transactions" do
        {{context.id}} do |parent, cnn|
          releases = cnn.releases
          rollbacks = cnn.savepoint_rollbacks
          parent.transaction { |tx| tx.rollback }.or_panic
          parent.transaction { |tx| tx.commit }.or_panic
          assert cnn.releases == releases + 1
          assert cnn.savepoint_rollbacks == rollbacks + 1
        end
      end

      it "transaction with block from parent transaction should be committed" do
        {{context.id}} do |parent, cnn|
          releases = cnn.releases
          seen = false
          parent.transaction do |tx|
            seen = true
            assert tx.is_a?(SavePointTransaction)
          end.or_panic
          assert seen
          assert cnn.releases == releases + 1
        end
      end

      it "only nested transaction should roll back on Rollback" do
        {{context.id}} do |parent, cnn|
          rollbacks = cnn.savepoint_rollbacks
          assert parent.transaction { |_| Rollback.new }.nil?
          assert cnn.savepoint_rollbacks == rollbacks + 1
          assert cnn.rollbacks == 0
          assert !parent.closed?
        end
      end
    end
  {% end %}
end
