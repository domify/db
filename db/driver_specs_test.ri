# crystal-db's src/spec.cr (`DB::DriverSpecs`) run end to end against a
# small in-memory driver, registered as "memory", that understands exactly
# the statements the syntax blocks below produce:
#
#   create table T (c1 type null, c2 type not null)
#   drop table if exists T
#   insert into T (c1, c2) values (e1, e2)    -- e: `?` or a literal
#   select c1, c2 from T / select * from T / select count(*) from T
#   select e [as type]                         -- a scalar
#   BEGIN / COMMIT / ROLLBACK / SAVEPOINT n / RELEASE SAVEPOINT n / ROLLBACK TO n
#
# Integers are stored as `Int64` (as sqlite does), so the result set reads
# an `Int32` from one. A transaction works on its connection's copy of the
# tables, published on COMMIT; savepoints are snapshots of that copy.
module db/driver_specs_test

import std/uri::{ParsedURI, URI, Params}
import std/text
import std/indexable
import db/db
import db/errors::*
import db/value::*
import db/core::*
import db/spec::{SpecSyntax, DriverSpecs}

import std/slice

alias MemoryValue = Nil | Bool | String | Int32 | Int64 | Float32 | Float64

CELLS = SlicePool(MemoryValue).new
NAMES = SlicePool(String).new
ROWS = SlicePool(MemoryRow).new
SNAPSHOTS = SlicePool(TableEntry).new

def stored_names(values : Array(String)) : SlicePool::Run(String)
  run = NAMES.alloc_slice(values.size)
  values.each_with_index { |value, i| run[i] = value.copy_to(Program.tape) }
  run
end

def stored_rows(values : Array(MemoryRow)) : SlicePool::Run(MemoryRow)
  run = ROWS.alloc_slice(values.size)
  values.each_with_index { |value, i| run[i] = value }
  run
end

@[OnTape]
struct MemoryRow
  getter values : SlicePool::Run(MemoryValue)

  def initialize
    @values = CELLS.alloc_slice(0)
  end

  def initialize(values : Array(DBValue))
    @values = CELLS.alloc_slice(values.size)
    values.each_with_index do |value, i|
      @values[i] = case value
      when String then value.copy_to(Program.tape)
      when Nil, Bool, Int32, Int64, Float32, Float64 then value
      else raise "unsupported memory fixture value"
      end
    end
  end

  def [](index : Int32) : DBValue
    @values[index]
  end

  def size : Int32
    @values.size
  end
end

@[OnTape]
struct MemoryTable
  getter columns : SlicePool::Run(String)
  getter sql_types : SlicePool::Run(String)
  @row_count : Int32

  def rows : SlicePool::Run(MemoryRow)
    @rows[0, @row_count]
  end

  def initialize(columns : Array(String), sql_types : Array(String), rows : Array(MemoryRow))
    @columns = stored_names(columns)
    @sql_types = stored_names(sql_types)
    @rows = ROWS.alloc_slice(1024)
    @row_count = rows.size
    rows.each_with_index { |row, i| @rows[i] = row }
  end

  def initialize(@columns : SlicePool::Run(String), @sql_types : SlicePool::Run(String), @rows : SlicePool::Run(MemoryRow), @row_count : Int32)
  end

  def column_index(name : String) : Int32?
    @columns.each_with_index { |value, i| return i if value == name }
    nil
  end

  def add_row(row : MemoryRow) : Nil
    raise "memory fixture row limit" if @row_count >= @rows.size
    @rows[@row_count] = row.copy_to(Program.tape)
    @row_count += 1
  end

  def copy : MemoryTable
    copied = ROWS.alloc_slice(1024)
    rows.each_with_index { |row, i| copied[i] = row }
    MemoryTable.new(@columns, @sql_types, copied, @row_count)
  end
end

@[OnTape]
struct TableEntry
  getter name : String
  getter table : MemoryTable?

  def initialize(@name : String = "", @table : MemoryTable? = nil)
  end
end

@[OnTape]
struct MemorySavepoint
  getter name : String
  getter tables : SlicePool::Run(TableEntry)

  def initialize(@name : String, tables : Hash(String, MemoryTable))
    @tables = SNAPSHOTS.alloc_slice(tables.size)
    i = 0
    tables.each do |name, table|
      @tables[i] = TableEntry.new(name, table.copy)
      i += 1
    end
  end
end

class MemoryStore
  @@tables = {} of String => MemoryTable
  @@working = {} of String => MemoryTable
  @@savepoints = [] of MemorySavepoint

  def self.tables(name : String) : Hash(String, MemoryTable)
    @@tables
  end

  def self.working : Hash(String, MemoryTable)
    @@working
  end

  def self.savepoints : Array(MemorySavepoint)
    @@savepoints
  end

  def self.publish(name : String, tables : Hash(String, MemoryTable)) : Nil
    copy_into(tables, @@tables)
  end

  def self.reset : Nil
    @@tables.clear
    @@working.clear
    @@savepoints.clear
  end

  def self.copy_into(tables : Hash(String, MemoryTable), into : Hash(String, MemoryTable)) : Nil
    into.clear
    tables.each { |name, table| into[name] = table.copy.copy_to(Program.tape) }
  end
end

@[OnTape]
struct MemoryResult
  getter names : SlicePool::Run(String)
  getter rows : SlicePool::Run(MemoryRow)
  getter rows_affected : Int64

  def initialize(names : Array(String), rows : Array(MemoryRow), @rows_affected : Int64 = 0_i64)
    @names = stored_names(names)
    @rows = stored_rows(rows)
  end
end

# Hands out the bound arguments in the order the `?`s appear.
class Binder
  @index = 0

  def initialize(@args : Array(DBValue))
  end

  def next_arg : DBValue | DBError
    return DBFailure.new("missing argument #{@index + 1}") if @index >= @args.size
    value = @args[@index]
    @index += 1
    value
  end
end

class MemoryDriver < Driver
  def new_connection(uri : URI | ParsedURI, options : Connection::Options) : Connection
    MemoryConnection.new(options, uri.host || "default")
  end
end

class MemoryConnection < Connection
  @in_transaction = false

  def initialize(options : Connection::Options, @database : String)
    super(options)

  end

  def build_statement(query : String, prepared : Bool) : Statement
    MemoryStatement.new(self, query, prepared)
  end

  def transaction_state : TransactionState
    @in_transaction ? TransactionState::InTransaction : TransactionState::Idle
  end

  def driver_name : String
    "memory"
  end

  # The tables this connection sees: its transaction's copy, if any.
  def tables : Hash(String, MemoryTable)
    @in_transaction ? MemoryStore.working : MemoryStore.tables(@database)
  end

  def execute(sql : String, args : Array(DBValue)) : MemoryResult | DBError
    sql = sql.strip
    lower = sql.downcase
    binder = Binder.new(args)

    if lower == "begin"
      return DBFailure.new("transaction already begun") if @in_transaction
      MemoryStore.copy_into(MemoryStore.tables(@database), MemoryStore.working)
      @in_transaction = true
      MemoryStore.savepoints.clear
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower == "commit"
      return DBFailure.new("no transaction to commit") unless @in_transaction
      working = MemoryStore.working
      MemoryStore.publish(@database, working)
      @in_transaction = false
      MemoryStore.savepoints.clear
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower == "rollback"
      return DBFailure.new("no transaction to roll back") unless @in_transaction
      @in_transaction = false
      MemoryStore.savepoints.clear
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower.starts_with?("savepoint ")
      return DBFailure.new("savepoint outside a transaction") unless @in_transaction
      working = MemoryStore.working
      MemoryStore.savepoints << MemorySavepoint.new(sql[10, sql.size - 10].strip, working).copy_to(Program.tape)
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower.starts_with?("release savepoint ")
      name = sql[18, sql.size - 18].strip
      index = savepoint_index(name) || return DBFailure.new("no such savepoint: #{name}")
      while MemoryStore.savepoints.size > index
        MemoryStore.savepoints.pop
      end
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower.starts_with?("rollback to ")
      name = sql[12, sql.size - 12].strip
      index = savepoint_index(name) || return DBFailure.new("no such savepoint: #{name}")
      MemoryStore.working.clear
      MemoryStore.savepoints[index].tables.each do |entry|
        MemoryStore.working[entry.name] = (entry.table || raise "missing snapshot table").copy.copy_to(Program.tape)
      end
      while MemoryStore.savepoints.size > index
        MemoryStore.savepoints.pop
      end
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower.starts_with?("create table ")
      return create_table(sql)
    end
    if lower.starts_with?("drop table if exists ")
      tables.delete(sql[21, sql.size - 21].strip)
      return MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
    end
    if lower.starts_with?("insert into ")
      return insert(sql, binder)
    end
    if lower.starts_with?("select ")
      if from = lower.index(" from ")
        return select_from(sql[7, from - 7].strip, sql[from + 6, sql.size - from - 6].strip)
      end
      return select_scalar(sql[7, sql.size - 7].strip, binder)
    end
    DBFailure.new("unsupported statement: #{sql}")
  end

  private def savepoint_index(name : String) : Int32?
    MemoryStore.savepoints.each_with_index do |savepoint, index|
      return index if savepoint.name == name
    end
    nil
  end

  private def create_table(sql : String) : MemoryResult | DBError
    open = sql.index('(') || return DBFailure.new("syntax error: #{sql}")
    name = sql[13, open - 13].strip
    return DBFailure.new("table #{name} already exists") if tables[name]?
    columns = [] of String
    sql_types = [] of String
    split_list(inside_parens(sql, open)).each do |definition|
      words = definition.split(' ')
      columns << words[0].copy_to(Program.tape)
      sql_types << words[1].copy_to(Program.tape)
    end
    tables[name.copy_to(Program.tape)] = MemoryTable.new(columns, sql_types, [] of MemoryRow).copy_to(Program.tape)
    MemoryResult.new([] of String, [] of MemoryRow).copy_to(Program.tape)
  end

  private def insert(sql : String, binder : Binder) : MemoryResult | DBError
    open = sql.index('(') || return DBFailure.new("syntax error: #{sql}")
    name = sql[12, open - 12].strip
    table = (tables[name]? || return DBFailure.new("no such table: #{name}")).copy_to(Program.tape)
    columns = split_list(inside_parens(sql, open))
    values_at = sql.downcase.index(" values ") || return DBFailure.new("syntax error: #{sql}")
    values_open = sql.index('(', values_at) || return DBFailure.new("syntax error: #{sql}")
    expressions = split_list(inside_parens(sql, values_open))
    return DBFailure.new("#{columns.size} columns but #{expressions.size} values") if columns.size != expressions.size

    row = [] of DBValue
    table.columns.each { row << nil }
    columns.each_with_index do |column, index|
      position = table.column_index(column) || return DBFailure.new("no such column: #{column}")
      value = evaluate(expressions[index], binder)!
      row[position] = persist(coerce(value, table.sql_types[position])).copy_to(Program.tape)
    end
    table.add_row(MemoryRow.new(row))
    tables[name] = table
    MemoryResult.new([] of String, [] of MemoryRow, 1_i64).copy_to(Program.tape)
  end

  private def select_from(list : String, name : String) : MemoryResult | DBError
    table = (tables[name]? || return DBFailure.new("no such table: #{name}")).copy_to(Program.tape)
    if list.downcase == "count(*)"
      count_row = [] of DBValue
      count_row << table.rows.size.to_i64
      return MemoryResult.new(["count(*)"], [MemoryRow.new(count_row)]).copy_to(Program.tape)
    end
    names = list == "*" ? table.columns.map { |name| name } : split_list(list)
    positions = [] of Int32
    names.each do |column|
      positions << (table.column_index(column) || return DBFailure.new("no such column: #{column}"))
    end
    rows = [] of MemoryRow
    table.rows.each do |stored|
      row = [] of DBValue
      positions.each { |position| row << stored[position] }
      rows << MemoryRow.new(row).copy_to(Program.tape)
    end
    MemoryResult.new(names, rows).copy_to(Program.tape)
  end

  # `e` or `e as type`.
  private def select_scalar(text : String, binder : Binder) : MemoryResult | DBError
    expression = text
    sql_type : String? = nil
    if at = text.downcase.index(" as ")
      expression = text[0, at].strip
      sql_type = text[at + 4, text.size - at - 4].strip
    end
    value = evaluate(expression, binder)!
    row = [] of DBValue
    row << coerce(value, sql_type)
    MemoryResult.new(["c0"], [MemoryRow.new(row)]).copy_to(Program.tape)
  end

  private def evaluate(expression : String, binder : Binder) : DBValue | DBError
    return binder.next_arg if expression == "?"
    return nil if expression.upcase == "NULL"
    if expression.size >= 2 && expression.starts_with?('\'') && expression.ends_with?('\'')
      return expression[1, expression.size - 2]
    end
    return true if expression == "true"
    return false if expression == "false"
    if integer = expression.to_i64?
      return integer
    end
    if float = expression.to_f?
      return float
    end
    DBFailure.new("invalid expression: #{expression}")
  end

  private def persist(value : DBValue) : MemoryValue
    case value
    when String then value.copy_to(Program.tape)
    when Nil, Bool, Int32, Int64, Float32, Float64 then value
    else raise "unsupported memory fixture value"
    end
  end

  # Integer columns hold `Int64`s.
  private def coerce(value : DBValue, sql_type : String?) : DBValue
    if sql_type == "int" || sql_type == "bigint"
      case value
      when Int32
        return value.to_i64
      end
    end
    value
  end

  # The text between the parenthesis at *open* and the one closing it,
  # parentheses inside quotes left alone.
  private def inside_parens(sql : String, open : Int32) : String
    close = sql.size
    depth = 0
    quoted = false
    position = 0
    sql.each_char do |char|
      if position > open && close == sql.size
        if char == '\''
          quoted = !quoted
        elsif !quoted && char == '('
          depth += 1
        elsif !quoted && char == ')'
          if depth == 0
            close = position
          else
            depth -= 1
          end
        end
      end
      position += 1
    end
    sql[open + 1, close - open - 1]
  end

  # *text* split at the commas outside quotes, each part stripped.
  private def split_list(text : String) : Array(String)
    parts = [] of String
    quoted = false
    start = 0
    index = 0
    while index < text.bytesize
      byte = text.byte_at(index)
      if byte == 39_u8
        quoted = !quoted
      elsif byte == 44_u8 && !quoted
        parts << text[start, index - start].strip
        start = index + 1
      end
      index += 1
    end
    last = text[start, text.bytesize - start].strip
    parts << last unless last.empty?
    parts
  end

end

class MemoryStatement < Statement
  @prepared : Bool

  def initialize(connection : Connection, command : String, @prepared : Bool)
    super(connection, command)
  end

  def prepared? : Bool
    @prepared
  end

  @result : MemoryResult? = nil

  protected def perform_query(args : Array(DBValue), arrays : DBArrays) : Nil | DBError
    @result = @connection.as(MemoryConnection).execute(command, args)!
    nil
  end

  protected def new_result_set : ResultSet
    MemoryResultSet.new(self, @result || raise "query not started")
  end

  protected def perform_exec(args : Array(DBValue), arrays : DBArrays) : ExecResult | DBError
    result = @connection.as(MemoryConnection).execute(command, args)!
    ExecResult.new(result.rows_affected, 0_i64)
  end
end

class MemoryResultSet < ResultSet
  @row_index = -1
  @column_index = 0

  def initialize(statement : Statement, @result : MemoryResult)
    super(statement)
  end

  def move_next : Bool | DBError
    @row_index += 1
    @column_index = 0
    @row_index < @result.rows.size
  end

  def column_count : Int32
    @result.names.size
  end

  def column_name(index : Int32) : String
    @result.names[index]
  end

  def read : DBValue | DBError
    return DBFailure.new("no row to read") unless 0 <= @row_index && @row_index < @result.rows.size
    row = @result.rows[@row_index]
    return DBFailure.new("no column #{@column_index} to read") if @column_index >= row.size
    value = row[@column_index]
    @column_index += 1
    value
  end

  def next_column_index : Int32
    @column_index
  end

  def read(t : String.class) : String | DBError
    index = @column_index
    @column_index += 1
    value = @result.rows[@row_index][index]
    value.is_a?(String) ? value : mismatch(index, value, "String")
  end

  def read(t : (String | Nil).class) : String | Nil | DBError
    index = @column_index
    @column_index += 1
    value = @result.rows[@row_index][index]
    case value
    when String, Nil then value
    else mismatch(index, value, "(String | Nil)")
    end
  end

  # An `Int32` is read from the stored `Int64`.
  def read(t : Int32.class) : Int32 | DBError
    index = next_column_index
    value = read!
    case value
    when Int64
      value.to_i32
    when Int32
      value
    else
      mismatch(index, value, "Int32")
    end
  end

  # `(Int32 | Nil).class`, not `Int32?.class`: ris 0.1.0 writes the short
  # spelling into an artifact as `Int32 | ::Nil.class`.
  def read(t : (Int32 | Nil).class) : Int32? | DBError
    index = next_column_index
    value = read!
    case value
    when Nil
      nil
    when Int64
      value.to_i32
    when Int32
      value
    else
      mismatch(index, value, "(Int32 | Nil)")
    end
  end

  private def mismatch(index : Int32, value : DBValue, expected : String) : DBError
    ColumnTypeMismatchError.new(
      context: "#{self.class}#read",
      column_index: index,
      column_name: column_name(index),
      column_type: value.class.to_s,
      expected_type: expected
    )
  end
end

::Db::Db.register_driver "memory", MemoryDriver

# The `prepared_statements` value of every run of the `:both` example below.
PREPARED_RUNS = [] of Bool

class MemorySyntax < SpecSyntax
  def binding(index : Int32) : String
    "?"
  end

  def select_scalar(expression : String, sql_type : String?) : String
    if t = sql_type
      "select #{expression} as #{t}"
    else
      "select #{expression}"
    end
  end

  def create_table_1column(table_name : String, col1 : DriverSpecs::ColumnDef) : String
    "create table #{table_name} (#{col1.name} #{col1.sql_type} #{col1.null ? "null" : "not null"})"
  end

  def create_table_2columns(table_name : String, col1 : DriverSpecs::ColumnDef, col2 : DriverSpecs::ColumnDef) : String
    "create table #{table_name} (#{col1.name} #{col1.sql_type} #{col1.null ? "null" : "not null"}, #{col2.name} #{col2.sql_type} #{col2.null ? "null" : "not null"})"
  end

  def insert_1column(table_name : String, col1 : DriverSpecs::ColumnDef, expr1 : String) : String
    "insert into #{table_name} (#{col1.name}) values (#{expr1})"
  end

  def insert_2columns(table_name : String, col1 : DriverSpecs::ColumnDef, expr1 : String, col2 : DriverSpecs::ColumnDef, expr2 : String) : String
    "insert into #{table_name} (#{col1.name}, #{col2.name}) values (#{expr1}, #{expr2})"
  end

  def select_1column(table_name : String, col1 : DriverSpecs::ColumnDef) : String
    "select #{col1.name} from #{table_name}"
  end

  def select_2columns(table_name : String, col1 : DriverSpecs::ColumnDef, col2 : DriverSpecs::ColumnDef) : String
    "select #{col1.name}, #{col2.name} from #{table_name}"
  end

  def select_count(table_name : String) : String
    "select count(*) from #{table_name}"
  end

  def drop_table_if_exists(table_name : String) : String
    "drop table if exists #{table_name}"
  end
end

syntax = MemorySyntax.new
DriverSpecs.run(syntax) do |specs|
  specs.connection_string "memory://specs"

  specs.before do
    MemoryStore.reset
  end

  specs.after do
    MemoryStore.reset
  end

  specs.encode_null "NULL"

  specs.sample_value "hello", "text", "'hello'"
  specs.sample_value 1, "int", "1"
  specs.sample_value 1_234_567_890_123_i64, "bigint", "1234567890123"
  specs.sample_value 1.5, "double", "1.5"
  specs.sample_value true, "bool", "true"

  specs.it "runs a custom example against the memory driver" do |db|
    db.scalar("select 42 as int") { |value| assert value == 42_i64 }.or_panic
    db.exec("create table table1 (col1 int not null)").or_panic
    assert db.exec("insert into table1 (col1) values (?)", 7).or_panic.rows_affected == 1
    db.query_one("select col1 from table1") { |rs| assert rs.read(Int32).or_panic == 7 }.or_panic
  end

  specs.it "reports raw transaction state independently of managed transactions", prepared: :both do |db|
    db.using_connection do |conn|
      assert conn.transaction_state == TransactionState::Idle
      conn.exec("BEGIN").or_panic
      assert conn.transaction_state == TransactionState::InTransaction
      conn.exec("SAVEPOINT state_check").or_panic
      conn.exec("ROLLBACK TO state_check").or_panic
      assert conn.transaction_state == TransactionState::InTransaction
      conn.exec("COMMIT").or_panic
      assert conn.transaction_state == TransactionState::Idle
      conn.exec("BEGIN").or_panic
      conn.exec("ROLLBACK").or_panic
      assert conn.transaction_state == TransactionState::Idle
      nil
    end.or_panic
  end

  specs.it "commits a transaction only on COMMIT", prepared: :both do |db|
    db.exec("create table table1 (col1 int not null)").or_panic
    db.transaction do |tx|
      tx.connection.exec("insert into table1 (col1) values (1)").or_panic
      tx.transaction do |nested|
        nested.connection.exec("insert into table1 (col1) values (2)").or_panic
      end.or_panic
      tx.connection.scalar("select count(*) from table1") { |value| assert value == 2_i64 }.or_panic
      ::Db::Db.open("memory://specs") do |other|
        other.scalar("select count(*) from table1") { |value| assert value == 0_i64 }.or_panic
      end.or_panic
    end.or_panic
    db.scalar("select count(*) from table1") { |value| assert value == 2_i64 }.or_panic
  end

  # The `:both` runs open the database with each `prepared_statements` value
  # (`DriverSpecs#with_db` merges it into the URI), and the statements
  # follow it.
  specs.it "prepares statements as the connection string says", prepared: :both do |db|
    PREPARED_RUNS << db.prepared_statements?
    db.query("select 1 as int") do |rs|
      assert rs.statement.as(MemoryStatement).prepared? == db.prepared_statements?
    end.or_panic
  end
end

assert PREPARED_RUNS.size == 2 && PREPARED_RUNS.includes?(true) && PREPARED_RUNS.includes?(false)
